# See https://nextjs.org/docs/app/building-your-application/deploying

# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ─────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ── TypeScript ───────────────────────────────────────────────────────────────
# next-env.d.ts is regenerated by `next dev` and `next build`.
*.tsbuildinfo
next-env.d.ts

# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
