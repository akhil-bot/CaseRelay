# Copy to .env.local and fill in.

# ── Control plane ────────────────────────────────────────────────────────────
# CaseRelay control-plane API base URL (no trailing slash).
# Used by the Admin page for case creation, runs, and SSE event streams.
NEXT_PUBLIC_API_BASE_URL=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app

# ── Chat agent (AG-UI over ADK) ─────────────────────────────────────────────
# AG-UI endpoint served by the control plane's /agui mount. The ADK chat agent
# runs gemini-3.5-flash on Vertex AI via Application Default Credentials.
# CopilotKit's HttpAgent connects here — no API key required client-side.
NEXT_PUBLIC_ADK_AGENT_URL=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app/agui/
