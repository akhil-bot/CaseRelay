# Copy to .env.local and fill in.

# ── Primary: ADK agent (Google-native, preferred for the hackathon) ──────────
# AG-UI endpoint exposed by the ADK backend — the FastAPI app that wraps the
# CaseRelay agent with `ag_ui_adk`'s ADKAgent middleware. All nine fleet agents
# run gemini-3.5-flash on Vertex AI reasoning engines.
NEXT_PUBLIC_ADK_AGENT_URL=http://localhost:8000/

# CaseRelay control-plane API base URL (no trailing slash).
# Used by the Admin page and any live-data surface.
NEXT_PUBLIC_API_BASE_URL=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app

# ── Fallback: built-in Gemini agent ─────────────────────────────────────────
# When no ADK agent URL is set, the runtime can run a BuiltInAgent backed by
# gemini-3.5-flash. Set both of these to enable it:
#
#   GOOGLE_API_KEY   — server-side only, used by the CopilotKit runtime to call
#                      the Gemini API. Not prefixed with NEXT_PUBLIC_ on purpose.
#
#   NEXT_PUBLIC_COPILOT_RUNTIME — tells the client to use the runtime route
#                                  instead of the in-browser preview agent.
GOOGLE_API_KEY=
NEXT_PUBLIC_COPILOT_RUNTIME=true
