# Copy to .env.local and fill in.

# AG-UI endpoint exposed by the ADK backend — the FastAPI app that wraps the
# CaseRelay agent with `ag_ui_adk`'s ADKAgent middleware.
#
# Leave this unset to run the portal's in-browser preview agent instead, which
# answers from the synthetic fixtures and makes no network calls.
NEXT_PUBLIC_ADK_AGENT_URL=http://localhost:8000/

# CaseRelay control-plane API base URL (no trailing slash).
# Used by the Admin page and any live-data surface.
NEXT_PUBLIC_API_BASE_URL=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app
