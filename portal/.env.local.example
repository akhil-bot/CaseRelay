# Copy to .env.local and fill in.

# ── Control plane (server-only) ─────────────────────────────────────────────
# Cloud Run service URL (no trailing slash). Used by the BFF proxy to forward
# API calls with a Google-signed ID token attached server-side.
# Requires: gcloud auth application-default login
#
# IMPORTANT: Set this to YOUR OWN deployed control plane URL (see deploy_control_plane.sh).
# The deployed service requires Google ID-token auth — a URL belonging to someone
# else's deployment will return 403 Forbidden.
# Obtain your URL after running: infra/deploy_control_plane.sh
CONTROL_PLANE_URL=https://<your-control-plane-url>.a.run.app

# Service account to impersonate for ID token minting. Required for local dev
# because user ADC credentials cannot mint ID tokens with custom audiences.
# The developer needs roles/iam.serviceAccountTokenCreator on this SA.
# Replace with the service account from your own GCP project.
CONTROL_PLANE_SA=<your-service-account>@<your-project>.iam.gserviceaccount.com

# ── Workload Identity Federation (Vercel deployment only) ──────────────────
# When deploying to Vercel, set these instead of CONTROL_PLANE_SA. Vercel
# issues an OIDC token that GCP exchanges for short-lived credentials — no
# long-lived secret needed. Leave unset for local development.
# GCP_PROJECT_NUMBER=123456789012
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=vercel@<project>.iam.gserviceaccount.com

# ── Chat agent toggle (client-safe) ────────────────────────────────────────
# Set to "true" to enable the CopilotKit chat surface. The actual agent URL
# is derived from CONTROL_PLANE_URL server-side — no credential is exposed.
NEXT_PUBLIC_COPILOT_ENABLED=true
