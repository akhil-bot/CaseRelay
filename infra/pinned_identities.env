# Pinned identity values for the CaseRelay fleet.
#
# INVARIANT: every engine — old, new, and the control plane — MUST use these exact values.
# The grant system in Firestore stores `granted_to` using the identity that intake loaded
# at the time the case was created. If a specialist's identity doesn't match, every
# authorized_context call fails with IdentityDenied, even though the A2A card returns 200.
#
# These values are derived from the CURRENT fleet's effectiveIdentity (the platform-managed
# principal tied to each engine's resource ID). They MUST NOT change during the gateway
# rollout — only CASERELAY_URL_* changes at cutover.
#
# To regenerate (ONLY after a full fleet replacement where all grants are re-created):
#   bash infra/collect_endpoints.sh --identities-only > infra/pinned_identities.env
#
# The deploy_fleet.sh guard refuses to deploy if values differ from this file.
export CASERELAY_IDENTITY_EDUCATION="agents.global.org-126484209344.system.id.goog/resources/aiplatform/projects/189353698936/locations/us-central1/reasoningEngines/6205121908900364288"
export CASERELAY_IDENTITY_HEALTH="agents.global.org-126484209344.system.id.goog/resources/aiplatform/projects/189353698936/locations/us-central1/reasoningEngines/2657974252392677376"
export CASERELAY_IDENTITY_LEGAL="agents.global.org-126484209344.system.id.goog/resources/aiplatform/projects/189353698936/locations/us-central1/reasoningEngines/3107630527687950336"
export CASERELAY_IDENTITY_SHELTER="agents.global.org-126484209344.system.id.goog/resources/aiplatform/projects/189353698936/locations/us-central1/reasoningEngines/8689420053348614144"
export CASERELAY_IDENTITY_FAMILY="agents.global.org-126484209344.system.id.goog/resources/aiplatform/projects/189353698936/locations/us-central1/reasoningEngines/7993613910919872512"
