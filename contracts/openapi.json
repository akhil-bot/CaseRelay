    "/v1/cases": {
      "get": {
        "summary": "List Cases",
        "description": "A page of cases, with enough of each to list a caseload without opening it.\n\n`volunteer_id`/`volunteer_name` are part of the projection because a\nsupervisor's caseload is grouped by advocate, and without them that grouping\nwould need one read per case.\n\n`status` narrows the set before it is paged, which is the difference between\nthe approvals queue fetching the drafts it is about to examine and fetching\nthe whole system to throw most of it away. It is not a security boundary:\nthis endpoint is still unscoped, and every caller may ask for every case.\n\n`X-Total-Count` carries the size of the narrowed set, before paging.",
        "operationId": "list_cases_v1_cases_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response List Cases V1 Cases Get"
                }
              }
            }
          },
          "403": {
            "description": "Identity denied"
