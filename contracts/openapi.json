    "/v1/approvals": {
      "get": {
        "summary": "List Approvals",
        "description": "Every quarantined action still waiting on a person.\n\nEach carries the child's name as well as the case id. A queue of approvals\nis read by a supervisor, and \"Riley Chen\" is the thing they recognise; the\nname is already to hand here, and without it the portal would have to open\nevery gated case just to caption a card.\n\nBuilt off the stored caseload rather than off whichever cases this process\nhas happened to load, and asking each of them only for its pending\napprovals. Reading the full aggregate per case to answer this made the route\nthe slowest on the control plane \u2014 ten seconds and more against a caseload\nthat is not large \u2014 because it fetched every case's commitments, grants and\naudit trail to look at none of them.",
        "operationId": "list_approvals_v1_approvals_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Approvals V1 Approvals Get"
                }
              }
            }
          },
          "403": {
            "description": "Identity denied"
          }
        }
      }
    },
