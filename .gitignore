# Workspace-level ignores. Build output and dependencies are ignored next to the
# workspace that produces them — see portal/.gitignore for the Next.js app.

# ── Operating system ─────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editors and tooling ──────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Secrets and local configuration ──────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# Google Cloud service account keys. A committed key is a live credential.
*-key.json
service-account*.json
*credentials*.json
application_default_credentials.json

# ── Python backend (FastAPI / ADK agents) ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── ADK local state and generated artifacts ──────────────────────────────────
# Session databases from `adk web` / `adk run`, and the agent cards that
# app/agent_server.py writes and deletes per process to control A2A routing.
.adk/
backend/agents/*/agent.json

# Written by the ADK deploy CLI on every deploy; describes one machine's run.
deployment_metadata.json

# ── Node ─────────────────────────────────────────────────────────────────────
# The Next.js app owns its own dependencies. A node_modules or a lockfile up
# here means an npm command was run from the wrong directory — there is no
# package.json at this level for either of them to describe.
node_modules/
/package-lock.json

# ── Logs and scratch ─────────────────────────────────────────────────────────
*.log
tmp/
.cache/

# ── Infrastructure build output ──────────────────────────────────────────────
infra/deploy_logs/

# ── Cursor ───────────────────────────────────────────────────────────────────
# Rules are project configuration: they tell whoever works here next how this
# repo expects to be treated, so they are committed like any other convention.
# Everything else Cursor writes under .cursor/ is one machine's local state.
.cursor/*
!.cursor/rules/

# Timestamped Vertex/ADK grade dumps. Pin a named baseline under
# artifacts/grade_results/ when a run should be kept; leave the rest local.
artifacts/grade_results/results_*.html
artifacts/grade_results/results_*.json
artifacts/recordings/

# ── Agent harness scratch ────────────────────────────────────────────────────
.omc/

# harness run logs
harness/logs/
harness/.current-task.md

# ── Internal working documents ───────────────────────────────────────────────
# The filming script and the post-video work queue record how the demo was
# staged and which screens were still unfinished when it was shot. They are
# notes to ourselves about a moment in time, not descriptions of the shipped
# system, and they misrepresent it when read on their own.
docs/demo-test-script.md
docs/post-video-geap-deploy.md

# Hand-downloaded package tarball; npm resolves this from the registry.
playwright-core-*.tgz
