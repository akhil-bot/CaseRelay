# Workspace-level ignores. Build output and dependencies are ignored next to the
# workspace that produces them — see portal/.gitignore for the Next.js app.

# ── Operating system ─────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editors and tooling ──────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Secrets and local configuration ──────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# Google Cloud service account keys. A committed key is a live credential.
*-key.json
service-account*.json
*credentials*.json
application_default_credentials.json

# ── Python backend (FastAPI / ADK agents) ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node ─────────────────────────────────────────────────────────────────────
# The Next.js app owns its own dependencies. A node_modules or a lockfile up
# here means an npm command was run from the wrong directory — there is no
# package.json at this level for either of them to describe.
node_modules/
/package-lock.json

# ── Logs and scratch ─────────────────────────────────────────────────────────
*.log
tmp/
.cache/

# ── Cursor ───────────────────────────────────────────────────────────────────
# Rules are project configuration: they tell whoever works here next how this
# repo expects to be treated, so they are committed like any other convention.
# Everything else Cursor writes under .cursor/ is one machine's local state.
.cursor/*
!.cursor/rules/
