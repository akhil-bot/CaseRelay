# CaseRelay control plane — environment template.
#
# Nothing loads this file automatically: there is no python-dotenv anywhere in the
# tree. Copy it and source it into the shell you run uvicorn from.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Every value below is a project identifier, a resource name or a URL. None of them
# is a credential — access comes from your own `gcloud auth application-default
# login` plus IAM roles on the project. There is no key to paste anywhere.
#
# See "Local Setup" in README.md for the full run procedure.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED TO RUN LOCALLY
# ─────────────────────────────────────────────────────────────────────────────

# String project id. Takes precedence over GOOGLE_CLOUD_PROJECT everywhere, because
# Agent Runtime overwrites that one with the numeric project NUMBER, which Firestore
# and Cloud Trace both reject in a resource name. Unset on both: code warns and falls
# back to "caserelay".
CASERELAY_PROJECT_ID=caserelay

# Read by the ADK/Vertex SDKs. Keep it equal to CASERELAY_PROJECT_ID locally.
GOOGLE_CLOUD_PROJECT=caserelay

# Send model calls to Vertex AI rather than the public Gemini API. Unset means the
# SDK looks for a GEMINI_API_KEY that this project does not use.
GOOGLE_GENAI_USE_VERTEXAI=true

# Model endpoint location. "global" is deliberate — it is the multi-region model
# endpoint, not a typo for us-central1. Regional resources carry their own vars below.
GOOGLE_CLOUD_LOCATION=global

# Persistence backend. "memory" keeps a run entirely in-process, which is the
# recommended local setting: no Firestore writes, no IAM beyond Vertex AI, and the
# README's local journey works end to end. Anything else (including unset) means
# Firestore — the opt-out is deliberate so a misconfigured deploy persists correctly.
CASERELAY_STATE=memory

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL LOCALLY — each one adds a cloud capability, none is needed to boot
# ─────────────────────────────────────────────────────────────────────────────

# Model Armor template used by the Safeguarding Verifier to screen partner replies.
# Unset, screen() fails closed: the callback is quarantined with reason
# "screening_unavailable", so the demo still reaches escalation but for the wrong
# reason. Set it to exercise real content screening (needs roles/modelarmor.user).
# MODEL_ARMOR_TEMPLATE=projects/caserelay/locations/us-central1/templates/caserelay-screen
# MODEL_ARMOR_LOCATION=us-central1

# GEAP Memory Bank instance (Agent Engine "caserelay-memory-bank"). Unset disables
# platform memory recall and the Firestore-backed memory in bank.py serves instead.
# CASERELAY_MEMORY_BANK_ID=8631858420611284992
# CASERELAY_MEMORY_BANK_LOCATION=us-central1

# Agent Platform Sessions engines. Unset locally means in-memory sessions that do not
# survive the process — fine for a local run, refused outright on a deployed control
# plane. Values also live in infra/run_sessions.env and infra/chat_sessions.env.
# CASERELAY_RUN_SESSION_ENGINE_ID=1247643881583935488
# CASERELAY_RUN_SESSION_LOCATION=us-central1
# CASERELAY_CHAT_SESSION_ENGINE_ID=5579754879393464320
# CASERELAY_CHAT_SESSION_LOCATION=us-central1

# Partner MCP server. Unset uses the in-process partner simulator in
# backend/partners/sim.py, which is what a local run wants. Set to the deployed
# service to route partner calls over MCP through the Agent Gateway instead.
# CASERELAY_PARTNER_MCP=1
# CASERELAY_PARTNER_MCP_URL=https://caserelay-partners-6nwo7o4bbq-uc.a.run.app

# Gemma end-of-run narrative summary. Defaults to gemma-4-26b-a4b-it-maas at
# location "global"; set the model to an empty string to turn the feature off.
# CASERELAY_GEMMA_MODEL=gemma-4-26b-a4b-it-maas
# CASERELAY_GEMMA_LOCATION=global

# Chat agent model. Defaults to gemini-3.5-flash when unset.
# gemma-4-26b-a4b-it-maas has been verified to call all four frontend tools
# correctly through ADK and is set on the deployed control plane.
# CASERELAY_CHAT_MODEL=gemma-4-26b-a4b-it-maas

# Raise application logging from INFO to DEBUG. Any non-empty value enables it.
# CASERELAY_DEBUG=1

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY-ONLY — do not set these for a local run
# ─────────────────────────────────────────────────────────────────────────────
# Setting CASERELAY_CONTROL_PLANE=1 locally turns three soft failures hard: the
# orchestrator refuses to fall back to in-process specialists, both session services
# refuse to be in-memory, and /v1/pubsub/push starts demanding a real OIDC token —
# which is exactly what makes the README's local sweep stand-in impossible.

# Marks this process as the deployed Cloud Run control plane.
# CASERELAY_CONTROL_PLANE=1

# Specialist and orchestrator endpoints plus the platform identity of each engine.
# Sixteen generated variables; do not hand-maintain them here. They are regenerated
# after every fleet deploy and committed to infra/fleet_endpoints.env:
#   source infra/fleet_endpoints.env
# With every CASERELAY_URL_* unset the orchestrator assembles the specialists
# in-process, which is what a local run relies on.

# Expected audience for the bearer token on Pub/Sub push. Falls back to the contents
# of infra/control_plane_url.txt when unset.
# CASERELAY_PUSH_AUDIENCE=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app

# Identity of a single-agent server process (app/agent_server.py), one per deployed
# engine. Also the flag that makes identity/registry.py refuse to invent placeholder
# principals, so never set it on a workstation.
# CASERELAY_AGENT=continuity_orchestrator
# CASERELAY_PUBLIC_URL=https://caserelay-<agent>.run.app

# Wake-event topic used by backend/workflows/durable.py, and the target of the
# Cloud Scheduler sweep. Only reached in Firestore mode.
# PUBSUB_TOPIC_EVENTS=caserelay-events

# Deploy scripts only (infra/deploy_*.sh), overriding their built-in defaults.
# CASERELAY_PROJECT=caserelay
# CASERELAY_REGION=us-central1

# Base URL infra/cloud_e2e.py dials. Falls back to infra/control_plane_url.txt.
# CASERELAY_CONTROL_PLANE_URL=https://caserelay-control-plane-6nwo7o4bbq-uc.a.run.app
