GOOGLE_CLOUD_PROJECT=caserelay
# Agent Runtime injects the project NUMBER into GOOGLE_CLOUD_PROJECT, which
# Firestore rejects when resolving the database. Set this to your project ID
# (not number) to override. Defaults to "caserelay" if neither is set.
# CASERELAY_PROJECT_ID=caserelay
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_REGION=us-central1
# Must be a named database, NOT (default). Google's Agent Runtime proxy
# URL-encodes parentheses → %28default%29, which Firestore rejects with 400.
FIRESTORE_DATABASE=caserelay
PUBSUB_TOPIC_EVENTS=caserelay-events
PUBSUB_TOPIC_DEAD_LETTER=caserelay-dead-letter
CLOUD_TASKS_QUEUE=caserelay-wakes
CLOUD_TASKS_LOCATION=us-central1
# Set CASERELAY_STATE=memory to run fully offline (Firestore is the default)
# CASERELAY_STATE=memory
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# --- Model Armor (content screening) ---
# Full resource name of the Model Armor template; unset disables armor screening.
# MODEL_ARMOR_TEMPLATE=projects/caserelay/locations/us-central1/templates/caserelay-screen
# MODEL_ARMOR_LOCATION=us-central1

# --- Control-plane mode ---
# Set to "1" on the Cloud Run control-plane service to enable deployed A2A dispatch.
# Omit or leave empty for local runs (in-process specialist fallback is used instead).
# CASERELAY_CONTROL_PLANE=1

# --- Agent-server identity (app/agent_server.py) ---
# Name of the specialist agent this server hosts (e.g. education_liaison).
# CASERELAY_AGENT=continuity_orchestrator
# Public base URL of this agent server, used to build A2A agent-card URLs.
# CASERELAY_PUBLIC_URL=https://caserelay-<agent>.run.app

# --- Pub/Sub push authentication ---
# Expected audience for the bearer token on incoming /v1/workflows/sweep push messages.
# CASERELAY_PUSH_AUDIENCE=https://caserelay-control-plane.run.app

# --- Specialist endpoint URLs (required when CASERELAY_CONTROL_PLANE=1) ---
# Base URLs of the deployed specialist engines; unset falls back to in-process agents.
# CASERELAY_URL_EDUCATION=https://caserelay-education.run.app
# CASERELAY_URL_HEALTH=https://caserelay-health.run.app
# CASERELAY_URL_LEGAL=https://caserelay-legal.run.app
# CASERELAY_URL_SHELTER=https://caserelay-shelter.run.app
# CASERELAY_URL_FAMILY=https://caserelay-family.run.app
# CASERELAY_URL_VERIFIER=https://caserelay-verifier.run.app

# --- Agent identity principals (required on deployed engines) ---
# Service-account email for each specialist; must match the Vertex AI service account.
# CASERELAY_IDENTITY_EDUCATION=caserelay-education@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_HEALTH=caserelay-health@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_LEGAL=caserelay-legal@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_SHELTER=caserelay-shelter@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_FAMILY=caserelay-family@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_INTAKE=caserelay-intake@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_ORCHESTRATOR=caserelay-orchestrator@caserelay.iam.gserviceaccount.com
# CASERELAY_IDENTITY_VERIFIER=caserelay-verifier@caserelay.iam.gserviceaccount.com

# --- Session engine IDs (Vertex AI Agent Engine / GEAP) ---
# Resource id of the Vertex AI reasoning engine used for orchestrator run sessions.
# CASERELAY_RUN_SESSION_ENGINE_ID=1234567890123456789
# CASERELAY_RUN_SESSION_LOCATION=us-central1
# Resource id of the reasoning engine used for portal chat sessions.
# CASERELAY_CHAT_SESSION_ENGINE_ID=1234567890123456789
# CASERELAY_CHAT_SESSION_LOCATION=us-central1

# --- Memory Bank (GEAP persistent memory) ---
# Resource id of the Vertex AI Memory Bank; unset disables platform memory recall.
# CASERELAY_MEMORY_BANK_ID=1234567890123456789
# CASERELAY_MEMORY_BANK_LOCATION=us-central1
