GOOGLE_CLOUD_PROJECT=caserelay
# Agent Runtime injects the project NUMBER into GOOGLE_CLOUD_PROJECT, which
# Firestore rejects when resolving the database. Set this to your project ID
# (not number) to override. Defaults to "caserelay" if neither is set.
# CASERELAY_PROJECT_ID=caserelay
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_REGION=us-central1
# Must be a named database, NOT (default). Google's Agent Runtime proxy
# URL-encodes parentheses → %28default%29, which Firestore rejects with 400.
FIRESTORE_DATABASE=caserelay
PUBSUB_TOPIC_EVENTS=caserelay-events
PUBSUB_TOPIC_DEAD_LETTER=caserelay-dead-letter
CLOUD_TASKS_QUEUE=caserelay-wakes
CLOUD_TASKS_LOCATION=us-central1
# Set CASERELAY_STATE=memory to run fully offline (Firestore is the default)
# CASERELAY_STATE=memory
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
